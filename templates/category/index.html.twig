{% extends 'base.html.twig' %}

{% block title %}Category Management{% endblock %}

{% block body %}
   <div class="container-fluid">
      <h3>Categories</h3>
      <ul class="list-group">
         {% for category in categories %}
            <li class="list-group-item d-flex justify-content-between align-items-center">
               <span class="me-3">{{ category.name }}</span>
               <span class="me-3">{{ category.type.value ?? '' }}</span>

               <!-- Adds spacing between name and buttons -->
               <div class="d-flex gap-2">
                  <a href="{{ path('app_category_edit', {'id': category.id}) }}" class="btn btn-sm btn-outline-warning">
                     Edit
                  </a>

                  <a href="{{ path('app_category_delete', {'id': category.id}) }}"
                     class="btn btn-sm btn-outline-danger"
                     onclick="return confirm('Are you sure you want to delete this category?')">
                     Delete
                  </a>
               </div>
            </li>
         {% endfor %}
      </ul>
   </div>

   <div class="container-fluid mt-4">
      <h4>Create New Category</h4>
      {{ form(form) }}
      <!--alternative way of creating a form-->
{#      {{ form_start(form) }}#}
{#      {{ form_row(form.name) }}#}
{#      {{ form_end(form, {render_rest: false}) }}#}
   </div>
{% endblock %}
